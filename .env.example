# Obligatoria: tu API key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: modelo a usar (por defecto claude-opus-5)
# Alternativas: claude-sonnet-5 (más rápido y económico)
ANTHROPIC_MODEL=claude-opus-5

# Opcional: nivel de esfuerzo del modelo -> low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Opcional: activa la búsqueda web en vivo para traer actualizaciones
# de Meta Ads / marketing digital (true | false)
BUSQUEDA_WEB=true
