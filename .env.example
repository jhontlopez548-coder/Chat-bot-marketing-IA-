# ─────────────────────────────────────────────────────────────────────────
#  TODAS ESTAS VARIABLES SON OPCIONALES
#
#  La forma más fácil de usar la app es NO configurar nada aquí y pegar la
#  llave directamente en el panel «Motor de IA» de la barra lateral. La llave
#  se guarda solo en el navegador de quien la pega.
#
#  Configure algo de esto únicamente si quiere que la app funcione para
#  cualquiera que la abra, sin que cada persona ponga su propia llave.
# ─────────────────────────────────────────────────────────────────────────

# Google Gemini — capa gratuita, no piden tarjeta
# Sáquela en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — capa gratuita, no piden tarjeta
# Sáquela en https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic (Claude) — de pago, requiere saldo
# Sáquela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Nivel de esfuerzo cuando se usa Anthropic: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Búsqueda web en vivo (solo disponible con Anthropic): true | false
BUSQUEDA_WEB=true
